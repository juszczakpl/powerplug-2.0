---
// Bazowy layout: <head> (SEO, fonty), skip-link, nagłówek, stopka.
import '../styles/base.css';
import '../styles/components.css';
import '../styles/sections.css';
import QuoteDialog from '../components/forms/QuoteDialog.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  header?: 'links' | 'compact' | false;
  footer?: boolean;
}
const { title, description = '', noindex = false, header = 'links', footer = true } = Astro.props;
const kit = import.meta.env.PUBLIC_ADOBE_FONTS_KIT || 'gpz4qwf'; // Adobe Fonts „PowerPlug WWW 2026” — tymczasowo do zakupu licencji webfont
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pl">
  <head>
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!window.__motion)document.documentElement.classList.add('reveal-off')},3000)</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {(__PREVIEW__ || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1a2e26" />
    {kit && <link rel="preconnect" href="https://use.typekit.net" crossorigin />}
    {kit && <link rel="stylesheet" href={`https://use.typekit.net/${kit}.css`} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    {header && <Header variant={header} />}
    <main id="tresc">
      <slot />
    </main>
    {footer && <Footer />}
    {!Astro.url.pathname.startsWith('/wycena') && <QuoteDialog />}
    <script>import '../scripts/motion.ts'; import '../scripts/forms.ts'; import '../scripts/quote.ts';</script>
  </body>
</html>

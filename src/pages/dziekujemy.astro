---
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
---
<Base title="Dziękujemy — PowerPlug" noindex>
  <section class="section plain-page"><div class="container container--narrow stack" style="--stack:var(--space-5)">
    <h1 class="t-h1">Dziękujemy! <span class="t-accent">Odezwiemy się.</span></h1>
    <p class="t-lead">Twoja wiadomość dotarła. Oddzwonimy lub odpiszemy najszybciej, jak to możliwe — zwykle tego samego dnia roboczego.</p>
    <div class="btn-group"><a class="btn btn--primary btn--lg" href="/"><Icon name="arrow-left" /><span>Strona główna</span></a><a class="btn btn--secondary btn--lg" href="/realizacje/">Zobacz realizacje</a></div>
  </div></section>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/sections/PageHero.astro';
import Steps from '../components/sections/Steps.astro';
import LinkCards from '../components/sections/LinkCards.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import Icon from '../components/ui/Icon.astro';
import { uslugi } from '../data/uslugi';
import { faqOgolne } from '../data/faq';
import foto from '../assets/uploads/realizacja-1730666776469.jpg';
---
<Base title="Usługi: doradztwo, projekt, montaż i serwis ładowarek | PowerPlug" description="Usługi PowerPlug: doradztwo w wyborze ładowarki, wizja lokalna, projekt instalacji, ekspertyza dopuszczalności, montaż i serwis stacji ładowania. Każdą usługę możesz zamówić osobno.">
  <PageHero eyebrow="Usługi" title="Pełen proces" accent="albo pojedyncza usługa." lead="Prowadzimy całą realizację — od wizji lokalnej po serwis — ale każdy etap możesz zamówić osobno: samo doradztwo, projekt, montaż kupionej już ładowarki albo przegląd stacji innego instalatora." image={foto} alt="Elektryk PowerPlug podłącza stację ładowania w garażu" crumbs={[{ label: 'Usługi' }]}>
    <div class="btn-group"><a class="btn btn--primary btn--lg" href="/wycena/"><Icon name="plus" /><span>Bezpłatna wycena</span></a><a class="btn btn--secondary btn--lg" href="#proces">Zobacz proces <Icon name="arrow-down" /></a></div>
  </PageHero>
  <section class="section section--sm section--soft">
    <div class="container stack" style="--stack:var(--space-6)">
      <div class="section-head"><p class="t-eyebrow">Wybierz usługę</p><h2 class="t-h2">Sześć usług, <span class="t-accent">jeden partner.</span></h2></div>
      <LinkCards items={uslugi.map((u, i) => ({ href: u.href, tytul: u.nazwa, tekst: u.lead, meta: `Krok ${i + 1} z 6${u.cenaOd ? ' · ' + u.cenaOd : ''}` }))} />
    </div>
  </section>
  <Steps />
  <FaqSection items={faqOgolne} />
  <CtaSection zrodlo="uslugi" />
</Base>

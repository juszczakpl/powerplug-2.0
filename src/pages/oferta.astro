---
import Base from '../layouts/Base.astro';
import PageHero from '../components/sections/PageHero.astro';
import LinkCards from '../components/sections/LinkCards.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import Icon from '../components/ui/Icon.astro';
import { oferta, obszar } from '../data/oferta';
import { faqOgolne } from '../data/faq';
import foto from '../assets/uploads/realizacja-1703799284692.jpg';
---
<Base title="Oferta: ładowarki do domu, stacje dla firm, garaże wspólnot | PowerPlug" description="Oferta PowerPlug: ładowarki samochodowe do domu, stacje ładowania dla firm i flot, ładowarki w garażach podziemnych, płatności za ładowanie i leasing. Szczecin i zachodniopomorskie.">
  <PageHero eyebrow="Oferta" title="Ładowanie tam," accent="gdzie stoi Twoje auto." lead="W domu, pod firmą albo w garażu bloku — każda lokalizacja wymaga innego podejścia. Wybierz swoją sytuację, a pokażemy, jak to zrobimy." image={foto} alt="Samochód elektryczny ładowany wieczorem ze stacji ładowania" crumbs={[{ label: 'Oferta' }]}>
    <div class="btn-group"><a class="btn btn--primary btn--lg" href="/wycena/"><Icon name="plus" /><span>Bezpłatna wycena</span></a><a class="btn btn--secondary btn--lg" href="/ladowarki/">Zobacz ładowarki</a></div>
  </PageHero>
  <section class="section section--soft">
    <div class="container stack" style="--stack:var(--space-6)">
      <div class="section-head"><p class="t-eyebrow">Kto? Gdzie?</p><h2 class="t-h2">Wybierz <span class="t-accent">swoją sytuację</span></h2></div>
      <LinkCards items={[...oferta, obszar].map((o) => ({ href: o.href, tytul: o.nazwa, tekst: o.krotko, ikona: o.ikona }))} />
    </div>
  </section>
  <FaqSection items={faqOgolne.slice(0, 5)} />
  <CtaSection zrodlo="oferta" />
</Base>

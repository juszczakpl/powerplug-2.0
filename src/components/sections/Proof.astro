---
// „Liczby mówią same za siebie. Klienci także.” — statystyki + opinie z CMS (Figma 123:313).
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { opinie, urzadzenia } from '../../lib/dane';
import { cmsImage } from '../../lib/cms-image';
import fallback from '../../assets/uploads/realizacja-1713133345879.jpg';
const op = await opinie();
const marki = new Set((await urzadzenia()).filter((u) => u.data.typ === 'ladowarka').map((u) => u.producentDane?.data.nazwa));
const stats = [
  ['+150', 'zamontowanych', 'ładowarek'],
  ['5 lat', 'gwarancji', 'producentów'],
  ['1 dzień', 'typowy czas', 'montażu'],
  [String(marki.size), 'marek ładowarek', 'w ofercie'],
];
---
<section class="section has-glow" aria-labelledby="proof-title">
  <div class="glow" style="--glow-size:50rem;left:-20rem;bottom:-20rem"></div>
  <div class="container proof">
    <div class="proof__head">
      <h2 id="proof-title" class="t-h2">Liczby mówią same za siebie. <span class="t-accent">Klienci także.</span></h2>
      <div class="section-head">
        <p class="t-eyebrow">Nasze doświadczenie</p>
        <p class="t-body-l">Montujemy ładowarki w Szczecinie i całym zachodniopomorskim — w domach, garażach podziemnych i na parkingach firm. Oto, co mówią o nas klienci.</p>
      </div>
    </div>
    <div class="proof__body">
      <ul class="stats">
        {stats.map(([v, a, b]) => <li class="stat"><span class="stat__value">{v}</span><span class="stat__label">{a}<br />{b}</span></li>)}
      </ul>
      {op.length > 0 && (
        <div class="slider" data-slider aria-roledescription="karuzela" aria-label="Opinie klientów">
          <div class="slider__track">
            {op.map((o, i) => (
              <figure class="testimonial slider__slide" aria-hidden={i === 0 ? 'false' : 'true'} aria-roledescription="slajd" aria-label={`${i + 1} z ${op.length}`}>
                <div class="media"><Image src={cmsImage(o.data.zdjecie) ?? fallback} alt={`Realizacja PowerPlug — ${o.data.miasto}`} width={760} /></div>
                <div class="testimonial__card">
                  <blockquote class="testimonial__quote">„{o.data.tresc}”</blockquote>
                  <figcaption class="testimonial__author">{o.data.autor}<span>{[o.data.miasto, o.data.rodzaj].filter(Boolean).join(' · ')}</span></figcaption>
                  <div class="slider-controls">
                    <div class="slider-controls__arrows">
                      <button type="button" class="btn-icon" data-prev><Icon name="arrow-left" /><span class="sr-only">Poprzednia opinia</span></button>
                      <button type="button" class="btn-icon" data-next><Icon name="arrow-right" /><span class="sr-only">Następna opinia</span></button>
                    </div>
                    <ul class="dots">{op.map((_, k) => <li aria-current={k === i ? 'true' : undefined}><button type="button" data-go={k}><span class="sr-only">Opinia {k + 1}</span></button></li>)}</ul>
                  </div>
                </div>
              </figure>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
<script>
  // Karuzela czasowa: pasek aktywnej kropki to loader czasu wyświetlania; po zapełnieniu → kolejna opinia.
  // Czas liczy się tylko, gdy slider jest na ekranie, karta aktywna i kursor/fokus nie jest w sliderze.
  const DUR = 8000;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slider__slide')];
    let i = 0, hover = false, inView = false, elapsed = 0, last = 0;
    const bar = () => slides[i].querySelector<HTMLElement>('.dots li[aria-current="true"]');
    const paint = () => bar()?.style.setProperty('--p', String(Math.min(elapsed / DUR, 1)));
    const go = (k: number) => {
      i = (k + slides.length) % slides.length;
      slides.forEach((s, n) => s.setAttribute('aria-hidden', String(n !== i)));
      elapsed = 0; paint();
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      if (b.hasAttribute('data-prev')) go(i - 1);
      else if (b.hasAttribute('data-next')) go(i + 1);
      else if (b.dataset.go) go(Number(b.dataset.go));
    });
    if (reduced || slides.length < 2) { root.classList.add('is-static'); return; }
    root.addEventListener('pointerenter', () => { hover = true; });
    root.addEventListener('pointerleave', () => { hover = false; });
    root.addEventListener('focusin', () => { hover = true; });
    root.addEventListener('focusout', () => { hover = false; });
    new IntersectionObserver(([en]) => { inView = en.isIntersecting; }, { threshold: 0.35 }).observe(root);
    const tick = (t: number) => {
      const dt = last ? Math.min(t - last, 100) : 0; last = t;
      if (inView && !hover && !document.hidden) {
        elapsed += dt;
        if (elapsed >= DUR) go(i + 1); else paint();
      }
      requestAnimationFrame(tick);
    };
    paint(); requestAnimationFrame(tick);
  });
</script>

---
// Mapa zasięgu: Szczecin w centrum, pierścienie co 10 km (30 km = dojazd bez dopłaty),
// miejscowości wg rzeczywistych współrzędnych. Kropki i lista prowadzą do stron lokalnych.
import { miejscowosci, SZCZECIN } from '../../data/lokalne';
interface Props { active?: string }
const { active } = Astro.props;
const R = 46; // km od środka do krawędzi
const pt = (lat: number, lng: number) => ({ x: (lng - SZCZECIN.lng) * Math.cos((SZCZECIN.lat * Math.PI) / 180) * 111.32, y: -(lat - SZCZECIN.lat) * 110.57 });
const kropki = miejscowosci.map((m) => ({ ...m, ...pt(m.lat, m.lng) }));
const etykieta = (x: number) => (x > 20 ? 'end' : 'start');
---
<div class="area-map">
  <svg viewBox={`${-R} ${-R} ${R * 2} ${R * 2}`} role="img" aria-label="Mapa zasięgu PowerPlug: Szczecin i okolice do 40 km">
    {[40, 20, 10].map((r) => <circle class="area-map__ring" cx="0" cy="0" r={r} vector-effect="non-scaling-stroke" />)}
    <circle class="area-map__ring area-map__ring--30" cx="0" cy="0" r="30" vector-effect="non-scaling-stroke" />
    <text class="area-map__ring-label" x="0" y="-31.5" text-anchor="middle" style="font-size:2.2px">30 km — dojazd bez dopłaty</text>
    <text class="area-map__ring-label" x="0" y="-41.5" text-anchor="middle" style="font-size:2.2px">40 km</text>
    {kropki.map((m) => (
      <a href={`/montaz-ladowarek-${m.slug}/`} class:list={['area-map__dot', m.km === 0 && 'area-map__dot--base', active === m.slug && 'is-active']} data-slug={m.slug} aria-label={`Montaż ładowarek — ${m.nazwa}`}>
        <circle class="area-map__halo" cx={m.x} cy={m.y} r={m.km === 0 ? 4.2 : 3} />
        <circle cx={m.x} cy={m.y} r={m.km === 0 ? 2 : 1.4} />
        <text x={m.x + (etykieta(m.x) === 'end' ? -3 : 3)} y={m.y + 1} text-anchor={etykieta(m.x)} style="font-size:2.6px">{m.nazwa}</text>
      </a>
    ))}
  </svg>
</div>

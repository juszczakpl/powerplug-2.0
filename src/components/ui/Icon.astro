---
// Zestaw ikon liniowych 24×24 (styl zbliżony do Streamline z Figmy). Kolor = currentColor.
export type IconName = keyof typeof icons;
interface Props { name: IconName; size?: number; label?: string; class?: string }
const { name, size, label, class: cls } = Astro.props;

const icons = {
  'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H5M11 6l-6 6 6 6"/>',
  'arrow-down': '<path d="M12 4v15M6 13l6 6 6-6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'plus-capsule': '<rect x="2" y="5.5" width="20" height="13" rx="6.5"/><path d="M7.5 12h9M12 7.5v9"/>',
  plus: '<path d="M12 4v16M4 12h16"/>',
  menu: '<path d="M7 9.5h10M7 14.5h10" stroke-width="2.4"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  home: '<path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9v11h13V9"/><path d="M10 20v-6h4v6"/>',
  building: '<rect x="4.5" y="3" width="15" height="18" rx="1"/><path d="M8.5 7h2M13.5 7h2M8.5 11h2M13.5 11h2M8.5 15h2M13.5 15h2"/>',
  parking: '<rect x="3.5" y="3.5" width="17" height="17" rx="2"/><path d="M9.5 17V7h3.5a3 3 0 0 1 0 6h-3.5"/>',

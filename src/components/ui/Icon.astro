  card: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 9.5h19M6 15h4"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  info: '<circle cx="12" cy="12" r="9.5"/><path d="M12 11v6M12 7.5v.5"/>',
  alert: '<path d="M12 3 2.5 20h19L12 3Z"/><path d="M12 10v4.5M12 17v.5"/>',
  phone: '<path d="M5 3.5h4l1.5 4.5-2.5 1.5a11 11 0 0 0 6 6l1.5-2.5 4.5 1.5v4a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3 5.5a2 2 0 0 1 2-2Z"/>',
  mail: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 6 9 7 9-7"/>',
  clock: '<circle cx="12" cy="12" r="9.5"/><path d="M12 6.5V12l3.5 2"/>',
  facebook: '<path d="M14.5 8H17V4.5h-2.5A4 4 0 0 0 10.5 8.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V8.5a.5.5 0 0 1 .5-.5Z" fill="currentColor" stroke="none"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6" fill="currentColor"/>',
  linkedin: '<path d="M4 9h3.5v11H4zM5.75 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM10 9h3.3v1.6c.5-.9 1.7-1.9 3.6-1.9 3.4 0 4.1 2.2 4.1 5.1V20h-3.5v-5.5c0-1.3 0-3-1.8-3s-2.2 1.4-2.2 2.9V20H10V9Z" fill="currentColor" stroke="none"/>',
  messenger: '<path d="M12 2.5c-5.4 0-9.5 3.9-9.5 9 0 2.8 1.3 5.3 3.4 7V22l3.2-1.8c.9.2 1.9.4 2.9.4 5.4 0 9.5-3.9 9.5-9s-4.1-9.1-9.5-9.1Z"/><path d="m6.5 14.5 4-4.3 2.2 2.2 4.3-2.2-4 4.3-2.2-2.2-4.3 2.2Z" fill="currentColor"/>',
  whatsapp: '<path d="M3.5 20.5 5 16a8.8 8.8 0 1 1 3.2 3.2l-4.7 1.3Z"/><path d="M9 8.5c.3 2.9 3.1 5.9 6.3 6.4l1.2-1.4-2-1-.9.9a5 5 0 0 1-2.4-2.4l.9-.9-1-2L9 8.5Z" fill="currentColor" stroke="none"/>',
} as const;

const body = icons[name];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
/>

  plug: '<path d="M9 3v5M15 3v5M6.5 8h11v3.5a5.5 5.5 0 0 1-11 0V8Z"/><path d="M12 17v4"/>',
  wrench: '<path d="M14.5 6.5a4 4 0 0 1 5-5l-2.5 3 .5 2 2 .5 3-2.5a4 4 0 0 1-5 5L8 19.5a2.1 2.1 0 0 1-3-3L14.5 6.5Z"/>',
  document: '<path d="M6 2.5h8.5L19 7v14.5H6Z"/><path d="M14 2.5V7h5M9 12h7M9 16h7"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>',
  chat: '<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9.5h8M8 12.5h5"/>',
  shield: '<path d="M12 2.5 4.5 5.5V11c0 5 3.3 8.6 7.5 10.5 4.2-1.9 7.5-5.5 7.5-10.5V5.5L12 2.5Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  calculator: '<rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M8 6.5h8M8.5 11h1M11.5 11h1M14.5 11h1M8.5 14.5h1M11.5 14.5h1M14.5 14.5h1M8.5 18h1M11.5 18h4"/>',
